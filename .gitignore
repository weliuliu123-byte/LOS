# ==========================================
# Embedded Linux Systems - Git Ignore
# ==========================================

# Build directories
**/build/

# Linux kernel source/build
linux-*/

# Kernel module build artifacts
*.o
*.ko
*.cmd
*.mod
*.mod.c
*.mod.o
*.symvers
modules.order
.tmp_versions/

# Generated filesystem images
*.cpio
*.cpio.gz
*.img
*.jffs2

# Kernel and bootloader binaries
zImage
vmlinux
u-boot

# Archives
*.tar
*.tar.gz
*.tar.xz

# Python
__pycache__/
*.pyc
.venv/

# Temporary files
*.swp
*.swo
*~

# Editor
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store